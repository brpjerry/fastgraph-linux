pkgname=fastgraph
# Must equal the workspace version in Cargo.toml; the release is tagged v$pkgver.
pkgver=0.1.1
pkgrel=1
pkgdesc='Headphone frequency-response measurement for PipeWire, with a Wayland GUI'
arch=('x86_64')
url='https://github.com/brpjerry/fastgraph-linux'
license=('GPL-3.0-or-later')
# Linked: glibc, libgcc (libgcc_s) and libpipewire. Not seen by ldd or namcap:
# pipewire is the audio server; pipewire-audio (its ALSA, Bluetooth and JACK
# plugins) and a session manager (wireplumber) create the microphone and
# headphone nodes the app lists; wayland, libxkbcommon and vulkan-icd-loader
# are dlopen()ed by winit and wgpu; fontconfig's /etc/fonts configuration is
# read to find system fonts; hicolor-icon-theme owns the icon directories.
depends=('glibc' 'libgcc' 'libpipewire' 'pipewire' 'pipewire-audio'
         'pipewire-session-manager' 'wayland' 'libxkbcommon' 'vulkan-icd-loader'
         'fontconfig' 'hicolor-icon-theme')
makedepends=('cargo' 'clang' 'pkgconf' 'python' 'git')
optdepends=('xdg-desktop-portal: file dialogs (with a FileChooser backend such as xdg-desktop-portal-gtk, -kde or -gnome)'
            'vulkan-driver: GPU rendering (falls back to the CPU renderer without one)')
conflicts=('fastgraph-git')
options=('!lto' '!debug')
source=("fastgraph-linux::git+https://github.com/brpjerry/fastgraph-linux.git#tag=v$pkgver")
sha256sums=('SKIP')
# The one supported target (arch is x86_64 only). Naming it on every Cargo
# call keeps a configured build.target from moving the binary away from the
# path package() installs.
_target="$CARCH-unknown-linux-gnu"


prepare() {
    cd "$srcdir/fastgraph-linux"
    export CARGO_TARGET_DIR=target
    cargo fetch --locked --target "$_target"
}

build() {
    cd "$srcdir/fastgraph-linux"
    export CARGO_TARGET_DIR=target
    # Keep the builder's home and build directories out of the binary.
    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo --remap-path-prefix=$srcdir=/build"
    cargo build --frozen --release --target "$_target" -p fastgraph
}

check() {
    cd "$srcdir/fastgraph-linux"
    export CARGO_TARGET_DIR=target
    # Keep the builder's home and build directories out of the binary.
    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo --remap-path-prefix=$srcdir=/build"
    # Core tests use temporary state and synthetic signals; the PipeWire
    # loopback tests are #[ignore]d and stay so (they load a null sink).
    cargo test --frozen --release --target "$_target" -p fastgraph-core
    # GUI tests render headless. tiny-skia is the CPU renderer, so no GPU,
    # display or audio server is needed and results do not depend on the
    # build machine's driver.
    ICED_TEST_BACKEND=tiny-skia cargo test --frozen --release --target "$_target" -p fastgraph
    python -m unittest discover -s packaging/arch -p 'test_*.py'
}

package() {
    cd "$srcdir/fastgraph-linux"
    install -Dm755 "target/$_target/release/fastgraph" "$pkgdir/usr/bin/fastgraph"
    install -Dm644 contrib/fastgraph.desktop "$pkgdir/usr/share/applications/fastgraph.desktop"
    install -Dm644 contrib/fastgraph.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/fastgraph.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    # Statically linked Rust dependencies retain their original license notices.
    python packaging/arch/collect-licenses.py "$pkgdir/usr/share/licenses/$pkgname/dependencies"
}
